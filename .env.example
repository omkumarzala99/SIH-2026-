# PS-26009 MOIL Mining Intelligence Platform Environment Configuration
# Copy this file to .env for local overrides

# Application Mode (live | demo)
APP_MODE=demo
DEBUG=True

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database Connection (SQLite for zero-config local demo, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/processed/moil_mining.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://moil_user:moil_pass@localhost:5432/moil_mining

# Satellite & Weather Data Provider Stubs / APIs
# In demo mode, synthetic feeds are utilized automatically.
MAP_TILE_PROVIDER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
SATELLITE_API_KEY=mock_sentinel_key_demo_only
WEATHER_API_KEY=mock_imd_weather_key_demo_only

# Model Registry Configuration
MODEL_DIR=./ai_ml/models
DEFAULT_CONFIDENCE_THRESHOLD=0.75
