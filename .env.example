# MOIL AI Mining Intelligence Platform - Environment Configuration Example
# Copy this file to .env for local development or set these variables in Render / Cloud hosting.

# Application Environment
ENVIRONMENT=development
APP_MODE=demo
DEBUG=false
PORT=8000

# Database Connection (SQLite for local zero-config, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/processed/moil_mining.db
# DATABASE_URL=postgresql://moil_user:your_password@localhost:5432/moil_mining

# Allowed CORS Origins (comma-separated or wildcard for public APIs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend API URL (Used during Vite build or client environment)
VITE_API_URL=http://localhost:8000/api

# Optional GIS Tile Configuration (Defaults to Esri World Imagery with zero API keys required)
# VITE_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# VITE_MAP_ATTRIBUTION=&copy; Esri &mdash; Earthstar Geographics

# Real-Time Meteorological Telemetry (Weatherstack API)
# Get a free key at https://weatherstack.com/
# If unset or invalid, the platform automatically fails over to local SQLite weather_observations
# WEATHERSTACK_API_KEY=your_weatherstack_api_key_here

# NASA FIRMS (Fire Information for Resource Management System) Telemetry
# Register for a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key
# If unset, the platform safely indicates 'no_observations' / 'unavailable' without crashing
# NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here
# FIRMS_SOURCE=VIIRS_NOAA21_NRT
# FIRMS_RADIUS_KM=20
# FIRMS_LOOKBACK_DAYS=1


